    <property name="styleSheet">
     <string notr="true">/* 🌌 Fenêtre principale : bleu foncé, police moderne */
QWidget {
    background-color: #012c4a;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
    color: white;
}

/* 🔷 Zone de texte moderne */
QLineEdit {
    background-color: #e6f2fa; /* Remplacé white */
    color: #012c4a;
    border: none;
    border-radius: 10px;
    padding: 8px 12px;
}

QLineEdit:focus {
    border: 2px solid #00aaff;
}

/* 🔘 Bouton stylé */
QPushButton {
    background-color: #00aaff;
    color: white;
    border-radius: 10px;
    padding: 8px 20px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0292c4;
}

/* 🔻 Combobox */
QComboBox {
    background-color: #e6f2fa; /* Remplacé white */
    color: #012c4a;
    border: none;
    border-radius: 10px;
    padding: 6px;
}

QComboBox QAbstractItemView {
    background-color: #e6f2fa;
    color: #012c4a;
    selection-background-color: #cceeff;
    selection-color: #012c4a;
}

/* 🧾 Label : titre centré */
QLabel#titleLabel {
    font-size: 24px;
    font-weight: bold;
    color: white;
    qproperty-alignment: AlignCenter;
}

/* 📦 TableView */
QTableView {
    background-color: #e6f2fa; /* Remplacé white */
    alternate-background-color: #dceffc;
    color: #012c4a;
    border: 1px solid #ccc;
    gridline-color: #ccc;
}

QHeaderView::section {
    background-color: #00aaff;
    color: white;
    padding: 6px;
    border: none;
}
</string>
